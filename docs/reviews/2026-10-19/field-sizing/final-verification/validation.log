await (async page => { const results=[]; const check=(name,pass,details)=>{results.push({name,pass,details});if(!pass)throw new Error(name+' '+JSON.stringify(details));}; await page.getByRole('button',{name:'Long · English',exact:true}).click(); const before=await page.locator('.candidate-field input').evaluateAll(inputs=>inputs.map(input=>input.value)); check('shared sample',before.every(value=>value.startsWith('A clear place')),before); await page.getByRole('textbox',{name:'Option B message',exact:true}).fill('独立编辑 · Native text'); const after=await page.locator('.candidate-field input').evaluateAll(inputs=>inputs.map(input=>input.value)); check('independent edits',after[0]===before[0]&&after[1]==='独立编辑 · Native text'&&after[2]===before[2],after); await page.getByRole('button',{name:'Try sending option B',exact:true}).click(); check('local send feedback',(await page.locator('.candidate-b [role=status]').textContent()).includes('Preview only'),null); for(const width of [320,393,768,1366]){await page.setViewportSize({width,height:900}); for(const article of await page.locator('.candidate').all()){await article.scrollIntoViewIfNeeded();await page.waitForTimeout(250);} const metrics=await page.locator('.candidate').evaluateAll(nodes=>nodes.map(node=>{const field=node.querySelector('.candidate-field'),input=node.querySelector('input'),hit=node.querySelector('.field-hit');const f=field.getBoundingClientRect(),i=input.getBoundingClientRect();return {option:node.className,w:f.width,h:f.height,inset:parseFloat(getComputedStyle(hit).paddingLeft),font:getComputedStyle(input).fontSize,padding:getComputedStyle(input).padding,align:getComputedStyle(input).textAlign,centerError:Math.abs(i.y+i.height/2-f.y-f.height/2),maxLength:input.maxLength,optical:field.dataset.opticalReady,error:field.dataset.opticalError||null};})); check('layout '+width,await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),metrics); for(const metric of metrics){check('native text '+width+' '+metric.option,metric.centerError<.5&&metric.font==='16px'&&metric.padding==='0px'&&metric.align==='left'&&metric.maxLength===240&&!metric.error,metric);} if(width===320||width===768)await page.screenshot({path:'output/playwright/field-sizing-review-2026-10-19/'+width+'-native-input.png',fullPage:true});} await page.getByRole('button',{name:'Placeholder',exact:true}).click();await page.getByRole('checkbox',{name:'Show text safe areas'}).uncheck();for(const article of await page.locator('.candidate').all()){await article.scrollIntoViewIfNeeded();await page.waitForTimeout(200);}await page.screenshot({path:'output/playwright/field-sizing-review-2026-10-19/desktop-placeholder.png',fullPage:true});await page.setViewportSize({width:393,height:852});for(const article of await page.locator('.candidate').all()){await article.scrollIntoViewIfNeeded();await page.waitForTimeout(200);}await page.screenshot({path:'output/playwright/field-sizing-review-2026-10-19/mobile-placeholder.png',fullPage:true});return results;})(page);
