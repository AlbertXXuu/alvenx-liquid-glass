+  // preimage of the horizontal primitive centreline, including tip motion.
+  const centreY = (x: number) => {
+    let y = 280;
+    if (dy) for (let i = 0; i < 6; i++) y = 280 + dy * Math.exp(-((x - deformX) ** 2 + (y - deformY) ** 2) / 11025);
+    return y;
+  };
